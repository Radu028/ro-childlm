+def causal_validation(model, tokenizer, args):
+    """Mean causal loss over the validation shards at the base seq_length."""
+    data = CausalDataset(args.valid_path, tokenizer, args, args.seq_length, rank=None, world_size=None)
+    loader = iter(DataLoader(data, shuffle=False, batch_size=args.local_batch_size,
+                             num_workers=0, drop_last=False, pin_memory=True))
+    model.eval()
+    total, batches = 0.0, 0
+    with torch.no_grad():
+        while True:
+            try:
+                input_ids, attention_mask, target_ids, _ = get_batch(loader, args.device, 0)
+            except StopIteration:
+                break
+            with torch.cuda.amp.autocast(args.mixed_precision, dtype=torch.bfloat16):
+                out = model(input_ids, attention_mask, target_ids, 0, args.ratio)
+            total += float(out[2])
+            batches += 1
+    model.train()
+    return total / max(batches, 1)
+
+
+def maybe_save_best(model, tokenizer, args, global_step):
+    import json as _json
+    val = causal_validation(model, tokenizer, args)
+    torch.cuda.empty_cache()
+    rec = {"global_step": global_step, "causal_val_loss": val,
+           "gpu_mem_gb": round(torch.cuda.memory_allocated() / 1e9, 2)}
+    with open(os.path.join(os.path.dirname(args.output_path), args.name + "_val_log.jsonl"), "a") as f:
+        f.write(_json.dumps(rec) + "\n")
+    best_attr = getattr(args, "_best_val", None)
+    if best_attr is None or val < best_attr:
+        args._best_val = val
+        model_to_save = model.module if hasattr(model, "module") else model
+        torch.save(model_to_save.state_dict(), args.output_path.replace(".bin", "_best.bin"))
+        with open(os.path.join(os.path.dirname(args.output_path), args.name + "_best.json"), "w") as f:
+            f.write(_json.dumps(rec))
+    return val
+
